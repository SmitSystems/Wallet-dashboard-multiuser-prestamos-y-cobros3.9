rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.uid == 'tHbizzoxtCcwpSycv4gxIIOPg5i1';
    }

    function esCobrador() {
      return request.auth != null
        && exists(/databases/$(db)/documents/users/$(request.auth.uid))
        && get(/databases/$(db)/documents/users/$(request.auth.uid)).data.activo == true;
    }

    match /users/{uid} {
      allow read: if esAdmin() || request.auth.uid == uid;
      allow write: if esAdmin();
    }

    match /solicitudes/{id} {
      allow read: if esAdmin()
        || (esCobrador() && resource.data.por == request.auth.uid);
      allow create: if esCobrador()
        && request.resource.data.por == request.auth.uid
        && request.resource.data.estado == 'pendiente';
      allow update, delete: if esAdmin();
    }
  }
}
